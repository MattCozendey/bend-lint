   if (io_gpu) {
@@ -308,11 +337,7 @@ static void window_fill(Env e, u32* pix, u32 w, u32 h, Term image, u32 k) {
     return;
   }
 #endif
-  for (u32 y = 0; y < h; y += 1) {
