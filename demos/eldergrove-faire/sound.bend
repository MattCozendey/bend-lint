# Eldergrove Faire -- the sound. Every sample is made here, by code, like
# the art: an organ waltz with an oom-pah accompaniment (an original tune,
# tables generated by tools/gentune.py), and effects built from simple
# waves and noise. A sample is a pure function of time: each effect only
# remembers when it last started.
#
# Samples are signed 16-bit values carried in U32 (two's complement), at
# 22050 frames a second; snd.c plays them through PulseAudio.
import Base

def sel(c: Bool, a: U32, b: U32) -> U32:
  match c:
    case True{}:
      a
    case False{}:
      b

def neg(+a: U32) -> Bool:
  (a >= 2147483648 : U32)

# arithmetic shift right (keeps the sign)
def sar(+v: U32, +k: Nat) -> U32:
  +nv = (v .^. 4294967295 : U32)
  sel(neg(v), ((nv >> k) .^. 4294967295 : U32), (v >> k : U32))

# signed v times a small gain g, then / 256
def gain(+v: U32, +g: U32) -> U32:
  sar((v * g : U32), 8n)

def hash(+x: U32) -> U32:
  +h = ((x * 374761393) + 668265263 : U32)
  +h2 = ((h .^. (h >> 13n)) * 1274126177 : U32)
  (h2 .^. (h2 >> 16n) : U32)

# waves of amplitude a from a phase (a full turn is 2^32)
def sq(+ph: U32, +a: U32) -> U32:
  sel((ph < 2147483648 : U32), a, (0 - a : U32))

def tri(+ph: U32, +a: U32) -> U32:
  +x = (ph >> 16n : U32)
  +t = sel((x < 32768 : U32), x, (65535 - x : U32))
  sar(((t * 2 - 32767) * a : U32), 15n)

def noise(+n: U32, +a: U32) -> U32:
  sar((((hash(n) >> 16n) - 32768) * a : U32), 15n)

# value noise: random levels every 2^k samples, blended between (softer)
def vnoise(+t: U32, +k: Nat, +a: U32) -> U32:
  +i = (t >> k : U32)
  +f = (t .&. ((1 << k) - 1) : U32)
  +x = noise(i, a)
  +y = noise((i + 1 : U32), a)
  (x + sar(((y - x) * f : U32), k) : U32)

