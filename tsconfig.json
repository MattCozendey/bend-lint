{
  "compilerOptions": {
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": { "bend2/*": ["./.bend2/*"] }
  },
  "include": ["src", "rules", "scripts"]
}
