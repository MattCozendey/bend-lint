{
  "name": "bend-lint",
  "version": "0.1.0",
  "private": true,
  "description": "Diagnostics for Bend 2 from rules outside the language: source text, and the checker's types",
  "license": "Apache-2.0",
  "bin": {
    "bend-lint": "./src/linter/seam.ts"
  },
  "type": "module",
  "scripts": {
    "c-cpu-prof-md": "bun ./src/meta/c-cpu-prof-md.ts",
    "format": "oxfmt --write --disable-nested-config .",
    "format:check": "oxfmt --check --disable-nested-config .",
    "lint": "bun ./src/meta/link-bend.ts && oxlint . && bun ./src/linter/seam.ts $(git ls-files \"*.bend\")",
    "sync-bend": "bun ./src/meta/sync-bend.ts",
    "test": "bun test --parallel",
    "typecheck": "bun ./src/meta/link-bend.ts && bun ./src/meta/typecheck.ts"
  },
  "dependencies": {
    "@oxlint/plugins": "1.87.0",
    "typebox": "1.3.36"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.4.3"
  },
  "packageManager": "bun@1.4.3",
  "bendRelease": "v2.0.36"
}
