{
  "name": "bend-lint",
  "version": "0.2.0",
  "private": true,
  "description": "Diagnostics for Bend 2 from rules outside the language: source text, and the checker's types",
  "license": "MIT",
  "bin": {
    "bend-lint": "src/linter/seam.ts"
  },
  "type": "module",
  "scripts": {
    "c-cpu-prof-md": "bun ./src/meta/c-cpu-prof-md.ts",
    "format": "oxfmt --write --disable-nested-config .",
    "format:check": "oxfmt --check --disable-nested-config .",
    "lint": "bun ./src/meta/link-bend.ts && oxlint . && bun ./src/linter/seam.ts $(git ls-files \"*.bend\" \":!demos\")",
    "ship": "bun ./src/meta/ship.ts",
    "sync-bend": "bun ./src/meta/sync-bend.ts",
    "test": "bun test --parallel",
    "typecheck": "bun ./src/meta/link-bend.ts && bun ./src/meta/typecheck.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@types/bun": "1.4.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typebox": "1.4.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "bendRelease": "bendlang/bend/v2.0.39",
  "bendWindows": "MattCozendey/bend/126afd6cbded7e392302b41d2504083ad26b40c1"
}
