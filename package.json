{
  "name": "bend-lint",
  "version": "0.1.0",
  "description": "Diagnostics for Bend 2 from rules outside the language: source text, and the checker's types",
  "private": true,
  "type": "module",
  "bin": {
    "bend-lint": "src/lint.ts"
  },
  "exports": "./src/lint.ts",
  "scripts": {
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test",
    "typecheck": "bun scripts/typecheck.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "license": "Apache-2.0"
}
