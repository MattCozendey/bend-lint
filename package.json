{
  "name": "bend-lint",
  "version": "0.1.0",
  "private": true,
  "description": "Diagnostics for Bend 2 from rules outside the language: source text, and the checker's types",
  "license": "Apache-2.0",
  "bin": {
    "bend-lint": "src/lint.ts"
  },
  "type": "module",
  "exports": "./src/lint.ts",
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "bun scripts/link-bend.ts && oxlint .",
    "sync-bend": "bun scripts/sync-bend.ts",
    "test": "bun test",
    "typecheck": "bun scripts/link-bend.ts && bun scripts/typecheck.ts"
  },
  "dependencies": {
    "typebox": "1.3.36"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.4.3"
  },
  "packageManager": "bun@1.4.3",
  "bendRelease": "v2.0.36"
}
