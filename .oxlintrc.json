{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": { "typeAware": true },
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
  "ignorePatterns": ["**/*.bend", "**/effects/**"],
  "jsPlugins": ["./src/oxlint-plugins/bend-lint.ts"],
  "rules": {
    "typescript/consistent-type-definitions": ["error", "type"],
    "eslint/max-classes-per-file": ["error", 0],
    "bend-lint/no-type-synonyms": "error",
    "eslint/sort-imports": ["error", { "ignoreCase": true, "ignoreDeclarationSort": true }],
    "import/first": "error",
    "import/newline-after-import": "error",
    "import/no-duplicates": "error",
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    "typescript/consistent-type-imports": "error"
  }
}
